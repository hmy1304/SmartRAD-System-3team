# ==========================================
# 1. Database (MySQL) 설정
# ==========================================
# MySQL Root 계정 비밀번호 (매우 강력한 비밀번호 사용 권장)
MYSQL_ROOT_PASSWORD=P@ssw0rd_Root_2026_Secure!

# 생성할 데이터베이스 이름
MYSQL_DATABASE=smartrad_db

# 애플리케이션(백엔드)이 사용할 DB 유저명
MYSQL_USER=smartrad_user

# 애플리케이션(백엔드)이 사용할 DB 비밀번호
MYSQL_PASSWORD=P@ssw0rd_App_2026_Secure!

