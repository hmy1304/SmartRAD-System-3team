# 프로덕션 서버용 환경변수 예시 파일
# 서버 배포 시 이 파일을 .env로 이름을 변경하고 보안상 강력한 비밀번호로 설정하세요.

MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=hp_db
MYSQL_USER=hp_db_user
MYSQL_PASSWORD=your_secure_db_password

# JWT Secret Key (백엔드에서 JWT를 사용 중이라면, 무작위로 생성한 64자리 이상의 문자열 입력)
# JWT_SECRET=your_super_secret_jwt_key_here

# 서버 도메인 주소 설정이 필요한 경우 추가 (프론트엔드 환경변수용)
# NEXT_PUBLIC_DOMAIN=http://your-domain.com
